{
  "name": "whip-blur",
  "kind": "transition",
  "description": "Directional blur spike at the cut point \u2014 the fake whip pan. Reads as energy on music-video cuts without needing matched camera motion.",
  "defaults": {
    "track": "V1",
    "index": 0,
    "at": 0,
    "amount": 60,
    "ramp": 0.12
  },
  "steps": [
    {
      "op": "effect.add",
      "track": "{{track}}",
      "index": "{{index}}",
      "matchName": "AE.ADBE Motion Blur"
    },
    {
      "op": "effect.keys",
      "track": "{{track}}",
      "index": "{{index}}",
      "effect": "Directional Blur",
      "param": "Blur Length",
      "keys": [
        {
          "t": "{{at}}",
          "v": 0,
          "interp": "linear"
        },
        {
          "t": "{{ramp}}",
          "v": "{{amount}}",
          "interp": "linear"
        }
      ]
    }
  ]
}