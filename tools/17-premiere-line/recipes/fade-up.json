{
  "name": "fade-up",
  "kind": "open",
  "description": "Opacity lift off black. Cleaner than a dissolve for the first frame of an ad.",
  "defaults": {
    "track": "V1",
    "index": 0,
    "dur": 0.5
  },
  "steps": [
    {
      "op": "effect.keys",
      "track": "{{track}}",
      "index": "{{index}}",
      "effect": "Opacity",
      "param": "Opacity",
      "keys": [
        {
          "t": 0,
          "v": 0,
          "interp": "bezier"
        },
        {
          "t": "{{dur}}",
          "v": 100,
          "interp": "bezier"
        }
      ]
    }
  ]
}