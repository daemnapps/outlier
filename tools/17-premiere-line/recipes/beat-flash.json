{
  "name": "beat-flash",
  "kind": "music",
  "description": "One-frame white lift on the beat. Stacked across a drop this is what makes a music video feel cut to the track.",
  "defaults": {
    "track": "V1",
    "index": 0,
    "at": 0,
    "frame": 0.04
  },
  "steps": [
    {
      "op": "effect.add",
      "track": "{{track}}",
      "index": "{{index}}",
      "matchName": "PR.ADBE Gamma Correction"
    },
    {
      "op": "effect.keys",
      "track": "{{track}}",
      "index": "{{index}}",
      "effect": "Gamma Correction",
      "param": "Gamma",
      "keys": [
        {
          "t": "{{at}}",
          "v": 1,
          "interp": "hold"
        },
        {
          "t": "{{frame}}",
          "v": 0.35,
          "interp": "hold"
        }
      ]
    }
  ]
}