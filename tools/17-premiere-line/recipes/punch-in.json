{
  "name": "punch-in",
  "kind": "move",
  "description": "Slow scale ramp across the clip. The workhorse for talking-head ad cuts \u2014 stops a static shot from feeling dead.",
  "defaults": {
    "track": "V1",
    "index": 0,
    "from": 100,
    "to": 112,
    "start": 0,
    "end": 3
  },
  "steps": [
    {
      "op": "effect.keys",
      "track": "{{track}}",
      "index": "{{index}}",
      "effect": "Motion",
      "param": "Scale",
      "keys": [
        {
          "t": "{{start}}",
          "v": "{{from}}",
          "interp": "bezier"
        },
        {
          "t": "{{end}}",
          "v": "{{to}}",
          "interp": "bezier"
        }
      ]
    }
  ]
}